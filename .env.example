# Instagram Content Management System Environment Configuration
# Copy this file to .env and insert your credentials.

# ==============================================================================
# OPTION 1: OFFICIAL DIRECT META INSTAGRAM GRAPH API (100% Free - Recommended)
# ==============================================================================
# 1. Create a free Meta App at: https://developers.facebook.com/
# 2. Add 'Instagram Graph API' product
# 3. Get token from Graph API Explorer: https://developers.facebook.com/tools/explorer
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# ==============================================================================
# OPTION 2: METRICOOL PUBLISHING (Secondary / Alternative)
# ==============================================================================
METRICOOL_TOKEN=your_metricool_token_here
METRICOOL_USER_ID=6200964
METRICOOL_BLOG_ID=7911973

# ==============================================================================
# BRAND IDENTITY & AUTOMATION
# ==============================================================================
BRAND_NAME=AI & Automation Explorer
CREATOR_HANDLE=@yourhandle
TIMEZONE=Asia/Kolkata
DAILY_POST_TIME=19:00:00

# Local Server Settings
CMS_PORT=8000
CMS_HOST=127.0.0.1

# Image staging host used to give Meta public image URLs (https://freeimage.host/page/api)
FREEIMAGE_API_KEY=your_freeimage_key_here
GITHUB_TOKEN=
